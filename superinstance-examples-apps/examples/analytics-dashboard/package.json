{
  "name": "@superinstance/analytics-dashboard",
  "version": "1.0.0",
  "description": "Real-time analytics dashboard with SuperInstance agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "docker:build": "docker build -t analytics-dashboard .",
    "docker:run": "docker run -p 3000:3000 analytics-dashboard"
  },
  "dependencies": {
    "@superinstance/claw-client": "^1.0.0",
    "@superinstance/constrainttheory": "^1.0.0",
    "@superinstance/shared-types": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "d3": "^7.8.5",
    "recharts": "^2.10.0",
    "zustand": "^4.4.7",
    "socket.io-client": "^4.6.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4",
    "@playwright/test": "^1.40.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  }
}
